PORT=4001
PUBLIC_BASE_URL=http://localhost:4001
CORS_ORIGIN=http://localhost:4000
NODE_ENV=development

# Genera uno propio (ej: openssl rand -hex 32) — nunca reutilices este valor.
JWT_SECRET=change-me-to-a-long-random-string

PGHOST=localhost
PGUSER=postgres
PGPASSWORD=
PGDATABASE=cotizador
PGPORT=5432
PGSSL=false

# SMTP — usado para enviar cotizaciones, verificación de email y recuperación de contraseña.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Cloudflare R2 (o cualquier bucket S3-compatible) — usado para logos y PDFs generados.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# MercadoPago — suscripción mensual de la app (trial de 2 días, luego $5.000 CLP/mes).
# MP_ACCESS_TOKEN es el access token de TU cuenta de MercadoPago (la que cobra la suscripción).
# MP_WEBHOOK_SECRET es la "clave secreta" que MercadoPago muestra al configurar el webhook
# en su panel (Tu negocio > Configuración > Webhooks) — sirve para verificar que el aviso
# de pago realmente viene de MercadoPago.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Login con Google — opcional: si se dejan vacíos, /auth/google responde 501 y el resto
# de la app sigue funcionando normal (login con correo/contraseña). Credenciales desde
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (tipo "Web application").
# Authorized redirect URI debe ser exactamente GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/auth/google/callback
# A dónde vuelve el navegador en el frontend después de un login con Google exitoso.
WEB_CALLBACK_URL=http://localhost:4000/auth/callback
